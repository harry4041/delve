<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity half of tests/parity.mjs. Loads the Unity version's compiled game code (Delve.Core has no UnityEngine dependency). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <UnityDir Condition="'$(UnityDir)' == ''">C:\Users\Hrjco\Delve</UnityDir>
    <UnityDll Condition="'$(UnityDll)' == ''">$(UnityDir)\Library\ScriptAssemblies\Assembly-CSharp.dll</UnityDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(UnityDll)</HintPath><Private>true</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(UnityDir)\Library\PackageCache\com.unity.nuget.newtonsoft-json@4dfd81071c64\Runtime\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
