rules_version = '2';

// saves/<uid>: one save per player. Only the owner, only with a verified email, only the expected fields, a size cap,
// a server-stamped time, and at most one write per 60 s (cost/abuse control, enforced server-side).
// gifts/global and gifts/<uid>: read-only for players; you create them in the Firebase console.
// lb/<uid>: the public leaderboard entry of a player who opted in (see leaderboard.js). Anyone may read (max 50 rows per
// query); only the verified owner may write: any first entry within the hard caps (no start ceiling, so a veteran can join or
// rejoin at any time), then values that never go down and rise at a plausible pace (lbGrowth).
// usernames/<lowercase name> and users/<uid>: see username.js. A leaderboard entry's name must equal its owner's username.
// banned/<uid>: create a document here in the console to stop an account publishing (delete lb/<uid> to remove its entry).
// These rules cannot prove a score is real: the game runs in the player's browser.
service cloud.firestore {
  match /databases/{database}/documents {

    // Hard ceilings for any entry (src/leaderboard.js LB.cap must match; tests/lb-rules-model.mjs checks it). The client trims its
    // scores to these, so a long-lived player is never locked out. Pace numbers come from tests/career.html (2026-11-13, ten relics):
    // an honest bot reached stage ~170 in 1 h and ~330 in 5.5 h, rose at most +55 stages and +9M power in 10 minutes, and
    // reached power ~44M; limits leave roughly 2-3x headroom.
    function lbShape(d) {
      return d.keys().hasOnly(['v', 'name', 'stage', 'power', 'asc', 'stars', 't'])
        && d.keys().hasAll(['v', 'name', 'stage', 'power', 'asc', 'stars', 't'])
        && d.v == 1
        && d.name is string && d.name.matches("^[A-Za-z0-9 _.'-]{3,18}$")
        && d.stage is int && d.stage >= 0 && d.stage <= 100000
        && d.power is int && d.power >= 0 && d.power <= 1000000000000000
        && d.asc is int && d.asc >= 0 && d.asc <= 10000
        && d.stars is int && d.stars >= 0 && d.stars <= 10000
        && d.t == request.time;
    }

    // Later entries (at least 5 minutes apart): stage/asc/stars never fall; each may rise by a small allowance plus a
    // per-minute rate, so a long gap between publishes still allows honest catch-up. Power may swing (it falls after an
    // ascension) but cannot grow more than tenfold plus a per-second allowance.
    function lbGrowth(old, d) {
      return request.time > old.t + duration.value(5, 'm')
        && d.stage >= old.stage && d.asc >= old.asc && d.stars >= old.stars
        && d.stage <= old.stage + 50 + (request.time.toMillis() - old.t.toMillis()) / 6000
        && d.asc <= old.asc + 2 + (request.time.toMillis() - old.t.toMillis()) / 120000
        && d.stars <= old.stars + 5 + (request.time.toMillis() - old.t.toMillis()) / 300000
        && d.power <= (old.power > 1000000 ? old.power : 1000000) * 10 + (request.time.toMillis() - old.t.toMillis()) / 1;
    }

    function nameOk(n) {
      return n is string && n.matches("^[A-Za-z0-9_.-]{3,18}$");
    }

    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['v', 'enc', 'data', 'clientT', 'summary', 'updatedAt'])
        && request.resource.data.keys().hasAll(['v', 'data', 'clientT', 'summary', 'updatedAt'])
        && (!('enc' in request.resource.data) || request.resource.data.enc in ['raw', 'gz1'])
        && request.resource.data.v == 1
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000
        && request.resource.data.clientT is number
        && request.resource.data.summary is map
        && request.resource.data.updatedAt == request.time
        && (resource == null || request.time > resource.data.updatedAt + duration.value(60, 's'));

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /gifts/{giftDoc} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && (giftDoc == 'global' || giftDoc == request.auth.uid);
      allow write: if false;
    }

    match /lb/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/banned/$(uid))
        && lbShape(request.resource.data)
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name // an entry may only use its owner's username
        && (resource == null || lbGrowth(resource.data, request.resource.data));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // usernames/<lowercase name>: claims a unique username (the doc id IS the name, so you can open it in the console to see the owner's uid).
    // Anyone signed in may read one doc (to check a name is free; no listing). Only a verified owner may create/rename/delete their own.
    match /usernames/{lower} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['uid', 'name', 't'])
        && request.resource.data.keys().hasAll(['uid', 'name', 't'])
        && request.resource.data.uid == request.auth.uid
        && nameOk(request.resource.data.name)
        && lower == request.resource.data.name.lower()
        && request.resource.data.t == request.time
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // users/<uid>: the player's own record (name only; no email). Written in the same transaction as the usernames/ claim, and the claim
    // must belong to this uid. At most one change a minute.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['v', 'name', 'lower', 't'])
        && request.resource.data.keys().hasAll(['v', 'name', 'lower', 't'])
        && request.resource.data.v == 1
        && nameOk(request.resource.data.name)
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.t == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.lower)).data.uid == request.auth.uid
        && (resource == null || request.time > resource.data.t + duration.value(60, 's'));
    }

    // Crystal wallets (shop): written ONLY by the shop server (server/worker.js, service account, which bypasses these rules).
    match /wallet/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /banned/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
