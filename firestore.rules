rules_version = '2';

// One save document per player at saves/<uid>. Players can only touch their own document, only with a
// verified email, only with the expected fields, and the server stamps the time. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['v', 'data', 'clientT', 'summary', 'updatedAt'])
        && request.resource.data.keys().hasAll(['v', 'data', 'clientT', 'summary', 'updatedAt'])
        && request.resource.data.v == 1
        && request.resource.data.data is string
        && request.resource.data.data.size() < 700000
        && request.resource.data.clientT is number
        && request.resource.data.summary is map
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
